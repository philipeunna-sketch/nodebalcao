# Runtime Node.js + Next.js com PostgreSQL/Supabase
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:6543/postgres

# SSL: prefer (TLS com fallback), require (exige TLS) ou disable
DATABASE_SSL=prefer

# Uploads de midia (Vercel Blob)
BLOB_READ_WRITE_TOKEN=

# URL canonica publica. Se vazio, usa a URL de producao da Vercel.
NEXT_PUBLIC_SITE_URL=
SITE_URL=

# Bootstrap inicial: usado somente quando portal_admins estiver vazio.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Contas comerciais iniciais opcionais.
# Formato: [{"email":"comercial@dominio.com","password":"senha-forte"}]
BOOTSTRAP_COMMERCIAL_ACCOUNTS_JSON=[]
