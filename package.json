{
  "name": "nodebalcao",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:generate:postgres": "drizzle-kit generate --config drizzle-postgres.config.ts",
    "db:migrate:postgres": "node --env-file-if-exists=.env.local scripts/migrate-postgres.mjs",
    "db:import:postgres": "node --env-file-if-exists=.env.local scripts/import-postgres-json.mjs"
  },
  "dependencies": {
    "@vercel/blob": "^1.1.1",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "nodemailer": "^7.0.6",
    "pdfjs-dist": "^6.2.108",
    "postgres": "^3.4.7",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/nodemailer": "^7.0.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Portal de Classificados Balcão - Node.js"
}
